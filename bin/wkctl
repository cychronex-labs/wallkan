#!/usr/bin/env python3
import socket
import os
import json
from sys import stderr
import sys

def get_socket_path():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if runtime_dir:
        return os.path.join(runtime_dir, "wallkan.sock")
    return f"/tmp/wallkan-{os.getuid()}.sock"

def setup_client_sock(sock_path):
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(sock_path)
        return sock
    except (FileNotFoundError, ConnectionRefusedError):
        print("Error: wallkan daemon is not running.", file=sys.stderr)
        sys.exit(1)

def send_command(sock, payload: dict):
    message = json.dumps(payload).encode('utf-8') + b'\n'
    sock.sendall(message)
    response_data = sock.recv(4096)
    return json.loads(response_data.decode('utf-8'))

def cleanup(sock):
    sock.close()

if __name__ == "__main__":
    sock = setup_client_sock(get_socket_path())
    response = send_command(sock,{
        "cmd": "quit"
    })
    print(response)
    cleanup(sock)
